# Recorder settings. Copy to .env (git-ignored) and fill in. Never commit .env.

# Recorder's own database (rec-postgres). Local only; port bound to 127.0.0.1.
REC_DB_USER=nova_rec
REC_DB_PASSWORD=change-me-local-only
REC_DB_NAME=nova_rec
REC_DB_PORT=5433

# The API NOVA calls (http://host.docker.internal:8100 from NOVA's broker).
REC_API_PORT=8100
# NOVA sends this in `x-rec-internal-token`. Same value as NOVA's NOVA_REC_TOKEN. Long and random.
REC_INTERNAL_TOKEN=change-me-to-a-long-random-value

# Same value as NOVA_BROKER_TOKEN_KEY in NOVA's .env: opens the sealed Kite token in memory.
# Empty = the recorder only waits.
NOVA_BROKER_TOKEN_KEY=

# debug | info | warning | error
REC_LOG_LEVEL=info
